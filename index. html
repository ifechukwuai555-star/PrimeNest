<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Chisom Homes - Find your perfect home, apartment, or investment property.">
  <title>Chisom Homes | Find Your Dream Home</title>

  <link rel="stylesheet" href="style.css">
</head>

<body>

  <!-- Navigation -->
  <header class="navbar">
    <div class="logo">
      <span>CH</span>
      Chisom Homes
    </div>

    <nav>
      <a href="#home">Home</a>
      <a href="#properties">Properties</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>

    <a href="#properties" class="nav-button">View Properties</a>
  </header>


  <!-- Hero Section -->
  <main>

    <section id="home" class="hero">

      <div class="hero-content">
        <p class="eyebrow">YOUR TRUSTED PROPERTY PARTNER</p>

        <h1>
          Find a place
          <span>you'll love</span>
          to call home.
        </h1>

        <p class="hero-text">
          Discover beautiful homes, apartments and investment properties
          in great locations.
        </p>

        <div class="hero-buttons">
          <a href="#properties" class="primary-button">
            Explore Properties
          </a>

          <a href="#contact" class="secondary-button">
            Contact Us
          </a>
        </div>
      </div>

      <div class="hero-card">
        <div class="hero-card-content">
          <p>Featured Property</p>
          <h3>Modern 4-Bedroom Duplex</h3>
          <span>📍 Lagos, Nigeria</span>
          <strong>₦85,000,000</strong>
        </div>
      </div>

    </section>


    <!-- Search -->
    <section class="search-section">

      <div class="search-box">

        <div class="search-field">
          <label>Location</label>
          <input
            type="text"
            id="locationSearch"
            placeholder="e.g. Lagos"
          >
        </div>

        <div class="search-field">
          <label>Property Type</label>

          <select id="typeSearch">
            <option value="all">All Types</option>
            <option value="house">House</option>
            <option value="apartment">Apartment</option>
            <option value="land">Land</option>
          </select>
        </div>

        <button id="searchButton" class="search-button">
          Search
        </button>

      </div>

    </section>


    <!-- Properties -->
    <section id="properties" class="properties-section">

      <div class="section-heading">
        <p class="eyebrow">OUR PROPERTIES</p>

        <h2>
          Explore our featured
          <span>properties</span>
        </h2>

        <p>
          Browse some of our available properties and find
          something that matches your needs.
        </p>
      </div>


      <div id="propertyGrid" class="property-grid">

        <!-- Property 1 -->
        <article
          class="property-card"
          data-location="Lagos"
          data-type="house"
        >

          <div class="property-image property-one">
            <span class="property-tag">For Sale</span>
          </div>

          <div class="property-info">

            <p class="property-location">📍 Lekki, Lagos</p>

            <h3>Luxury 4-Bedroom Duplex</h3>

            <div class="property-details">
              <span>🛏 4 Beds</span>
              <span>🛁 4 Baths</span>
              <span>🚗 2 Parking</span>
            </div>

            <div class="property-bottom">
              <strong>₦85,000,000</strong>

              <button class="details-button">
                Details
              </button>
            </div>

          </div>
        </article>


        <!-- Property 2 -->
        <article
          class="property-card"
          data-location="Abuja"
          data-type="apartment"
        >

          <div class="property-image property-two">
            <span class="property-tag">For Rent</span>
          </div>

          <div class="property-info">

            <p class="property-location">📍 Wuse 2, Abuja</p>

            <h3>Modern 3-Bedroom Apartment</h3>

            <div class="property-details">
              <span>🛏 3 Beds</span>
              <span>🛁 3 Baths</span>
              <span>🚗 1 Parking</span>
            </div>

            <div class="property-bottom">
              <strong>₦4,500,000/year</strong>

              <button class="details-button">
                Details
              </button>
            </div>

          </div>
        </article>


        <!-- Property 3 -->
        <article
          class="property-card"
          data-location="Enugu"
          data-type="land"
        >

          <div class="property-image property-three">
            <span class="property-tag">For Sale</span>
          </div>

          <div class="property-info">

            <p class="property-location">📍 Enugu, Nigeria</p>

            <h3>Residential Land</h3>

            <div class="property-details">
              <span>📐 600 sqm</span>
              <span>📄 Verified</span>
              <span>🛣 Road Access</span>
            </div>

            <div class="property-bottom">
              <strong>₦18,000,000</strong>

              <button class="details-button">
                Details
              </button>
            </div>

          </div>
        </article>

      </div>

      <p id="noResults" class="no-results">
        No properties found. Try another search.
      </p>

    </section>


    <!-- Why Choose Us -->
    <section class="why-section">

      <div class="section-heading">
        <p class="eyebrow">WHY CHOOSE US</p>

        <h2>
          Making property search
          <span>simple</span>
        </h2>
      </div>


      <div class="features">

        <div class="feature">
          <div class="feature-icon">🏠</div>
          <h3>Quality Properties</h3>
          <p>
            We showcase carefully selected properties
            for different budgets and needs.
          </p>
        </div>

        <div class="feature">
          <div class="feature-icon">🤝</div>
          <h3>Trusted Service</h3>
          <p>
            We focus on making the property search
            experience clear and straightforward.
          </p>
        </div>

        <div class="feature">
          <div class="feature-icon">📍</div>
          <h3>Great Locations</h3>
          <p>
            Discover properties in desirable locations
            across Nigeria.
          </p>
        </div>

      </div>

    </section>


    <!-- About -->
    <section id="about" class="about-section">

      <div class="about-content">

        <p class="eyebrow">ABOUT CHISOM HOMES</p>

        <h2>
          Helping people find
          <span>better places</span>
          to live.
        </h2>

        <p>
          Chisom Homes is a demonstration real-estate brand
          created to showcase a modern property website.
          Our goal is to make discovering properties simple,
          convenient and enjoyable.
        </p>

        <a href="#contact" class="primary-button">
          Talk To Us
        </a>

      </div>

      <div class="about-statistics">

        <div>
          <strong>100+</strong>
          <span>Properties</span>
        </div>

        <div>
          <strong>50+</strong>
          <span>Happy Clients</span>
        </div>

        <div>
          <strong>5+</strong>
          <span>Locations</span>
        </div>

      </div>

    </section>


    <!-- Contact -->
    <section id="contact" class="contact-section">

      <div class="section-heading">

        <p class="eyebrow">CONTACT US</p>

        <h2>
          Ready to find your
          <span>next home?</span>
        </h2>

        <p>
          Send us a message and we'll help you find
          a property that suits your needs.
        </p>

      </div>


      <div class="contact-card">

        <div class="contact-item">
          <span>📱</span>
          <div>
            <strong>Phone</strong>
            <p>+234 800 000 0000</p>
          </div>
        </div>

        <div class="contact-item">
          <span>📧</span>
          <div>
            <strong>Email</strong>
            <p>hello@chisomhomes.com</p>
          </div>
        </div>

        <div class="contact-item">
          <span>📍</span>
          <div>
            <strong>Location</strong>
            <p>Nigeria</p>
          </div>
        </div>

      </div>

    </section>

  </main>


  <!-- WhatsApp Button -->
  <a
    href="https://wa.me/2348000000000"
    class="whatsapp-button"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contact us on WhatsApp"
  >
    💬
  </a>


  <!-- Footer -->
  <footer>

    <div class="footer-logo">
      CHISOM HOMES
    </div>

    <p>
      © 2026 Chisom Homes. Demo website created for portfolio purposes.
    </p>

  </footer>


  <script src="script.js"></script>

</body>
</html>
