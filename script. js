document.addEventListener("DOMContentLoaded", () => {
  // =========================
  // MOBILE MENU
  // =========================
  const menuButton = document.getElementById("menuButton");
  const mainNav = document.getElementById("mainNav");

  if (menuButton && mainNav) {
    menuButton.addEventListener("click", () => {
      const isOpen = mainNav.classList.toggle("active");

      menuButton.setAttribute("aria-expanded", String(isOpen));
      menuButton.textContent = isOpen ? "✕" : "☰";
    });

    mainNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mainNav.classList.remove("active");
        menuButton.setAttribute("aria-expanded", "false");
        menuButton.textContent = "☰";
      });
    });
  }

  // =========================
  // PROPERTY SEARCH
  // =========================
  const locationSearch = document.getElementById("locationSearch");
  const typeSearch = document.getElementById("typeSearch");
  const priceSearch = document.getElementById("priceSearch");
  const searchButton = document.getElementById("searchButton");

  const propertyCards = document.querySelectorAll(".property-card");

  function searchProperties(scrollToResults = false) {
    const location = (locationSearch?.value || "")
      .trim()
      .toLowerCase();

    const type = (typeSearch?.value || "all").toLowerCase();
    const maxPrice = priceSearch?.value || "all";

    let visibleCount = 0;

    propertyCards.forEach((card) => {
      const cardLocation =
        (card.dataset.location || "").toLowerCase();

      const cardType =
        (card.dataset.type || "").toLowerCase();

      const cardPrice =
        Number(card.dataset.price || 0);

      const locationMatches =
        !location || cardLocation.includes(location);

      const typeMatches =
        type === "all" || cardType === type;

      const priceMatches =
        maxPrice === "all" ||
        cardPrice <= Number(maxPrice);

      const shouldShow =
        locationMatches &&
        typeMatches &&
        priceMatches;

      card.style.display = shouldShow ? "" : "none";

      if (shouldShow) {
        visibleCount++;
      }
    });

    let noResults = document.getElementById("noResults");

    if (!noResults) {
      noResults = document.createElement("p");
      noResults.id = "noResults";
      noResults.textContent =
        "No properties match your search.";
      noResults.style.textAlign = "center";
      noResults.style.marginTop = "20px";

      const propertyGrid =
        document.getElementById("propertyGrid");

      propertyGrid?.parentElement?.appendChild(noResults);
    }

    noResults.style.display =
      visibleCount === 0 ? "block" : "none";

    if (scrollToResults) {
      document
        .getElementById("properties")
        ?.scrollIntoView({
          behavior: "smooth"
        });
    }
  }

  searchButton?.addEventListener("click", () => {
    searchProperties(true);
  });

  locationSearch?.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
      searchProperties(true);
    }
  });

  typeSearch?.addEventListener("change", () => {
    searchProperties(false);
  });

  priceSearch?.addEventListener("change", () => {
    searchProperties(false);
  });

  // =========================
  // PROPERTY DETAILS MODAL
  // =========================
  const modal = document.getElementById("propertyModal");
  const closeModalButton =
    document.getElementById("closeModal");

  const modalTitle =
    document.getElementById("modalTitle");

  const modalLocation =
    document.getElementById("modalLocation");

  const modalDetails =
    document.getElementById("modalDetails");

  const modalPrice =
    document.getElementById("modalPrice");

  function openPropertyModal(button) {
    if (!modal || !button) return;

    if (modalTitle) {
      modalTitle.textContent =
        button.dataset.title || "Property";
    }

    if (modalLocation) {
      modalLocation.textContent =
        button.dataset.location || "";
    }

    if (modalDetails) {
      modalDetails.textContent =
        button.dataset.details || "";
    }

    if (modalPrice) {
      modalPrice.textContent =
        button.dataset.price || "";
    }

    modal.classList.add("active");
    modal.setAttribute("aria-hidden", "false");
  }

  function closePropertyModal() {
    if (!modal) return;

    modal.classList.remove("active");
    modal.setAttribute("aria-hidden", "true");
  }

  document
    .querySelectorAll(".details-button")
    .forEach((button) => {
      button.addEventListener("click", () => {
        openPropertyModal(button);
      });
    });

  closeModalButton?.addEventListener(
    "click",
    closePropertyModal
  );

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) {
      closePropertyModal();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closePropertyModal();
    }
  });

  // =========================
  // FAVORITES
  // =========================
  const favoriteButtons =
    document.querySelectorAll(".favorite-button");

  const FAVORITES_KEY = "primeNestFavorites";

  let favorites = [];

  try {
    favorites = JSON.parse(
      localStorage.getItem(FAVORITES_KEY) || "[]"
    );
  } catch {
    favorites = [];
  }

  favoriteButtons.forEach((button, index) => {
    const card = button.closest(".property-card");

    const favoriteId =
      `${card?.dataset.location || "property"}-${index}`;

    button.dataset.favoriteId = favoriteId;

    const alreadyFavorite =
      favorites.includes(favoriteId);

    button.classList.toggle(
      "active",
      alreadyFavorite
    );

    button.textContent =
      alreadyFavorite ? "♥" : "♡";

    button.addEventListener("click", () => {
      const currentIndex =
        favorites.indexOf(favoriteId);

      if (currentIndex !== -1) {
        favorites.splice(currentIndex, 1);

        button.classList.remove("active");
        button.textContent = "♡";
      } else {
        favorites.push(favoriteId);

        button.classList.add("active");
        button.textContent = "♥";
      }

      localStorage.setItem(
        FAVORITES_KEY,
        JSON.stringify(favorites)
      );
    });
  });

  // =========================
  // CONTACT FORM
  // =========================
  const contactForm =
    document.getElementById("contactForm");

  const formMessage =
    document.getElementById("formMessage");

  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();

    if (formMessage) {
      formMessage.textContent =
        "Thanks! Your inquiry has been received.";
    }

    contactForm.reset();
  });
});
